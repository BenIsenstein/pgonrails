# These are overridden by docker-compose.yml environment block.
# For local dev outside Docker, set these to your self-hosted Supabase instance:
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used in password reset emails to construct the redirect URL
SITE_URL=http://localhost:3001

# Set to "true" to require OTP reauthentication when changing password in settings
VITE_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION=false

# Client-side (Vite prefix) — used by browser Supabase client for settings mutations
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key-here
