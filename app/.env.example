# These are overridden by docker-compose.yml environment block.
# For local dev outside Docker, set these to your self-hosted Supabase instance:
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client-side (Vite prefix) — used if any client components need direct Supabase access
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key-here
